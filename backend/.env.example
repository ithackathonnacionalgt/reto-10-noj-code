# ---------------------------------------------------------------------------
# Backend - Plataforma Nacional de Tramites (CLAUDE.md 20, 48)
# Copiar a backend/.env y completar. NUNCA commitear .env con valores reales.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# ===========================================================================
# BASE DE DATOS (Supabase) - por credenciales sueltas
# ===========================================================================
# En Supabase: boton "Connect" (arriba) -> pestana "Session pooler".
# Recomendado el Session pooler: funciona por IPv4 y sirve para runtime Y
# migraciones. (La conexion directa "db.<ref>.supabase.co" suele ser solo IPv6.)
#
#   Host     -> aws-0-<region>.pooler.supabase.com
#   Port     -> 5432                (Session pooler; NO uses 6543 aqui)
#   User     -> postgres.<project-ref>
#   Password -> la contrasena de la base
#   Database -> postgres
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=tu-password-de-la-base
DB_NAME=postgres
DB_SSL=true
TYPEORM_LOGGING=false

# (Opcional) Conexion aparte solo para migraciones. Si se omite, usa las DB_*.
# DB_DIRECT_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
# DB_DIRECT_PORT=5432
# DB_DIRECT_USER=postgres
# DB_DIRECT_PASSWORD=tu-password-de-la-base
# DB_DIRECT_NAME=postgres

# (Alternativa) En vez de las DB_* podes pasar una sola cadena:
# DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
# DIRECT_URL=postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres

# ===========================================================================
# SUPABASE (API / Storage)
# ===========================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================================================
# AUTENTICACION (JWT propio)
# ===========================================================================
JWT_SECRET=pon-aqui-un-string-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Keys para desarrolladores
API_KEY_PEPPER=otro-string-largo-y-aleatorio

# CORS (lista separada por comas)
CORS_ORIGINS=http://localhost:3000

# Seed (opcional): credenciales del primer super administrador
SEED_ADMIN_EMAIL=admin@tramites.gob.gt
SEED_ADMIN_PASSWORD=CambiaEstaClave123!

# Storage (buckets)
STORAGE_BUCKET_PROCEDURES=procedure-assets
STORAGE_BUCKET_SUBMISSIONS=submission-files
STORAGE_BUCKET_INSTITUTIONS=institution-assets
STORAGE_BUCKET_VIDEOS=accessibility-videos
