{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typeorm": "node --env-file=.env --import tsx ./node_modules/typeorm/cli.js",
    "typeorm:prod": "node --import tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d ./src/database/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d ./src/database/data-source.ts",
    "migration:run:prod": "npm run typeorm:prod -- migration:run -d ./src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/database/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d ./src/database/data-source.ts",
    "schema:log": "npm run typeorm -- schema:log -d ./src/database/data-source.ts",
    "seed": "node --env-file=.env --import tsx ./src/database/seed/seed.ts",
    "seed:prod": "node --import tsx ./src/database/seed/seed.ts",
    "enrich:catalogo": "node ./src/database/seed/enriquecer-catalogo.mjs",
    "import:catalogo": "node --env-file=.env --import tsx ./src/database/seed/importar-catalogo.ts",
    "import:catalogo:prod": "node --import tsx ./src/database/seed/importar-catalogo.ts",
    "import:extraidos": "node --env-file=.env --import tsx ./src/database/seed/importar-extraidos.ts",
    "import:extraidos:prod": "node --import tsx ./src/database/seed/importar-extraidos.ts",
    "generar:etiquetas": "node --env-file=.env --import tsx ./src/database/seed/generar-etiquetas.ts",
    "generar:etiquetas:prod": "node --import tsx ./src/database/seed/generar-etiquetas.ts",
    "db:setup": "npm run migration:run && npm run seed",
    "start:prod:migrate": "npm run migration:run:prod && npm run start:prod",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
